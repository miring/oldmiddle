# 복사해서 .env.local로 만들고 값을 채웁니다. (.env.local은 커밋되지 않음)
# 두 값이 있으면 신청이 Supabase에 저장되고, 없으면 지금처럼 콘솔에만 찍힙니다.
VITE_SUPABASE_URL=https://프로젝트ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 정식 홈 미리보기(#/home)를 운영 빌드에서도 열지. 오픈 전(site.siteMode = 'prelaunch')에만 쓰입니다.
# Vercel Preview 환경에만 true. Production에는 절대 넣지 말 것 (넣으면 운영 사이트에서 #/home이 열림)
# VITE_HOME_PREVIEW=true
